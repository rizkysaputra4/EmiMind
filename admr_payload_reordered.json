  "narratives": [
    {
      "section": "NOTE_1_GENERAL",
      "text_original": "PT Alamtri Minerals Indonesia Tbk (dahulu bernama PT Adaro Minerals Indonesia Tbk) bergerak di bidang usaha aktivitas perusahaan holding, jasa pertambangan, penyewaan mesin, serta investasi melalui entitas anak. Entitas anak PT Kalimantan Aluminium Industry (KAI) sedang mengembangkan proyek smelter aluminium di kawasan industri KIPI di Kalimantan Utara.",
      "source_page": 12,
      "topic": "General Corporate Overview"
    },
    {
      "section": "NOTE_37_SEGMENT",
      "text_original": "Grup mengoperasikan 3 segmen bisnis utama: Pertambangan batubara metalurgi, Pengolahan logam (smelter aluminium yang sedang tahap konstruksi), dan Jasa lainnya. Pendapatan eksternal segmen pertambangan mencapai US.807 ribu dari total US.878 ribu.",
      "source_page": 101,
      "topic": "Segment Performance"
    }
  ],
